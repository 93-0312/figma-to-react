{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Figma sync manifest",
  "type": "object",
  "required": ["fileKey", "components"],
  "properties": {
    "fileKey": { "type": "string", "description": "Figma 파일 키" },
    "fileName": { "type": "string" },
    "lastSyncedVersion": {
      "type": ["string", "null"],
      "description": "마지막으로 동기화한 Figma 파일 version id (diff 트리거용)"
    },
    "lastSyncedAt": { "type": ["string", "null"], "description": "ISO timestamp" },
    "tokens": {
      "type": "object",
      "properties": {
        "css": { "type": "string" },
        "tailwind": { "type": "string" },
        "sourcePages": { "type": "object" },
        "note": { "type": "string" }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file", "figmaNodeId"],
        "properties": {
          "name": { "type": "string" },
          "file": { "type": "string", "description": "컴포넌트 소스 경로" },
          "story": { "type": ["string", "null"] },
          "figmaPage": { "type": "string" },
          "figmaNodeId": { "type": "string", "description": "Figma 노드 id (component set)" },
          "variants": { "type": "object" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
